<% layout('layout/boilerplate') %>

<div class="container mt-4">
    <h2 class="mb-3">My Bookings</h2>

    <% if (alllistings.length === 0) { %>
        <div class="alert alert-info" role="alert">
            You have not booked any listing yet.
        </div>
        <a href="/listings" class="btn btn-secondary">Browse Listings</a>
    <% } else { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mt-1">
            <% for(let listing of alllistings) { %>
                    <div class="col">
                        <div class="card h-100 listing-card">
                            <a href="/listings/<%= listing._id %>" class="listing-link">
                                <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" style="height: 200px; object-fit: cover;">
                            </a>
                            <div class="card-img-overlay"> HimStays</div>
                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title"><%= listing.title %></h5>
                                <p class="card-text">
                                    <strong>Price:</strong> &#8377;<%= listing.price %> /Night<br>
                                    <strong>Location:</strong> <%= listing.location %><br>
                                </p>
                                <form method="POST" action="/listings/<%= listing._id %>/cancel-booking" class="mt-auto">
                                    <button class="btn btn-outline-danger btn-sm w-100">Cancel Booking</button>
                                </form>
                            </div>
                        </div>
                    </div>
            <% } %>
        </div>
    <% } %>
</div>
