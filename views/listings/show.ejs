<% layout('layout/boilerplate') %>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <h1 class="mb-4"><%= listing.title %></h1>
        <div class="card listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
            <div class="card-body">
                <p class="card-text"><strong>Owned By:</strong><i><%= listing.owner.username %></i></p>
                <p class="card-text"><strong>Description:</strong> <%= listing.description %></p>
                <p class="card-text"><strong>Price:</strong> &#8377;<%= listing.price.toLocaleString("en-IN") %></p>
                <p class="card-text"><strong>Location:</strong> <%= listing.location %></p>
                <p class="card-text"><strong>Country:</strong> <%= listing.country %></p>

                <% if (currentUser && hasBooked && !currentUser._id.equals(listing.owner._id)) { %>
                <form method="POST" action="/calls/<%= listing._id %>/initiate" class="mb-2">
                    <button class="btn btn-outline-primary btn-sm">Start Video Call with Owner</button>
                </form>
                <% } %>
                <div id="book-actions" class="d-flex justify-content-between mt-3 flex-wrap gap-2">
                    <a href="/listings" class="btn btn-secondary">Back to Listings</a>
                    <% if (currentUser && !currentUser._id.equals(listing.owner._id)) { %>
                        <% if (hasBooked) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/cancel-booking" style="display: inline;">
                        <button class="btn btn-outline-danger">Cancel Booking</button>
                    </form>
                        <% } else { %>
                    <form method="POST" action="/listings/<%= listing._id %>/book" style="display: inline;">
                        <button class="btn btn-warning">Book now</button>
                    </form>
                        <% } %>
                    <% } %>
                    <% if(currentUser && currentUser._id.equals(listing.owner._id)) {%>
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-primary">Edit</a>
                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="display: inline;">
                        <button class="btn btn-danger">Delete</button>
                    </form>
                    <% } %>
                </div>

                <hr class="my-4">
                <h5 class="mb-2">Location on map</h5>
                <p class="text-muted small mb-2">
                    Map tiles © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors.
                    Pin is estimated from the address (Nominatim). Map stays in this box — use marker to open details.
                </p>
                <div class="listing-map-shell rounded border bg-light">
                    <div id="listing-map" class="listing-map-inner"></div>
                </div>
                <p id="listing-map-status" class="small text-muted mt-2 mb-0"></p>
            </div>
        </div>
    </div>

    <% if (currentUser){%>
    <div class="col-8 offset-2 mt-3">
        <hr>
        <h4> Leave a review: </h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
            <label for="rating" class="form-label">Rating </label>
            <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset> 
            </div>
            <div class="mb-3 mt-3">
                <label for ="comment" class="form-label"">Comment</label>
                <textarea name="review[comment]" required rows="5" cols="30" id="comment" class="form-control"></textarea>
                <div class="invalid-feedback">Please provide some comments for review</div>
            </div>
            <div class="mb-3 mt-3">
                <br>
                <button class="btn btn-outline-dark">Submit Review</button>
            </div>
        </form>
    <% } %>
        <hr>
        
        <p><b> Reviews:</b> </p>
        <div class="row">
        <% for(review of listing.reviews) { %>
            <div class="card col-5 ms-2 mb-3 ">
                <div class="card-body">
                    <h5 class="card-title mt-3"><%= review.author.username %></h5>
                    <p class="starability-result card-text mt-3" data-rating="<%= review.rating %>"></p>
                    <p class="card-text mt-3">Comment: <%= review.comment %></p>
                </div>
                <div>
                <form class="mb-3 mt-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                    <button class="btn btn-danger btn-sm">Delete Review</button>
                </form>
                </div>

            </div>
            <% } %>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR6BMY=" crossorigin="" />
<style>
  /* Keep Leaflet layers and popups clipped to this card region (no full-page overlay) */
  .listing-map-shell {
    position: relative;
    height: 260px;
    max-width: 100%;
    overflow: hidden;
    isolation: isolate;
    contain: layout paint;
  }
  .listing-map-inner {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .listing-map-shell .leaflet-container {
    width: 100%;
    height: 100%;
    z-index: 0;
    font-family: inherit;
  }
  .listing-map-shell .leaflet-popup-content-wrapper {
    max-width: min(280px, 92vw);
  }
  .listing-map-shell .leaflet-popup-content {
    max-height: 180px;
    overflow: auto;
    margin: 10px 12px;
  }
</style>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script>
(function () {
    const MAP_ID = "listing-map";
    const STATUS_ID = "listing-map-status";
    const query = <%- JSON.stringify(`${listing.location}, ${listing.country}`) %>;
    const title = <%- JSON.stringify(listing.title) %>;
    const priceLabel = <%- JSON.stringify(`₹${listing.price.toLocaleString("en-IN")} / night`) %>;
    const listingUrl = <%- JSON.stringify(`/listings/${listing._id}`) %>;

    const statusEl = document.getElementById(STATUS_ID);
    function setStatus(msg) {
        if (statusEl) statusEl.textContent = msg;
    }

    async function loadCoords() {
        const res = await fetch("/listings/geocode?q=" + encodeURIComponent(query), {
            headers: { Accept: "application/json" },
        });
        const data = await res.json().catch(function () { return null; });
        if (!res.ok || !data || typeof data.lat !== "number" || typeof data.lon !== "number") {
            throw new Error("Could not resolve location");
        }
        return data;
    }

    function buildMap(lat, lon, meta) {
        var map = L.map(MAP_ID).setView([lat, lon], 13);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        }).addTo(map);
        var marker = L.marker([lat, lon]).addTo(map);
        var popupHtml =
            "<b>" + title.replace(/</g, "&lt;") + "</b><br>" +
            priceLabel.replace(/</g, "&lt;") + "<br>" +
            "<small>" + String(meta.display_name || query).replace(/</g, "&lt;") + "</small><br>" +
            '<a href="' + listingUrl + '#book-actions">View listing &amp; book</a>';
        marker.bindPopup(popupHtml);
        setTimeout(function () { map.invalidateSize(); }, 200);
        if (meta.fallback) {
            setStatus("Approximate position (address not found precisely).");
        } else {
            setStatus("Pin from address search: " + (meta.display_name || ""));
        }
    }

    loadCoords()
        .then(function (meta) {
            setStatus("Loading map…");
            buildMap(meta.lat, meta.lon, meta);
        })
        .catch(function () {
            setStatus("Map could not load; showing default Himachal view.");
            buildMap(31.1048, 77.1734, { display_name: "Shimla area (default)", fallback: true });
        });
})();
</script>
