<% layout('layout/boilerplate') %>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card p-4">
                <h3>Calling owner for <%= call.listing.title %>...</h3>
                <p class="text-muted mb-2">Waiting for owner to accept your video call request.</p>
                <p>Status: <span id="call-status" class="fw-bold">ringing</span></p>

                <div id="join-box" class="mt-3" style="display:none;">
                    <a id="join-link" href="#" class="btn btn-primary">Join Video Call</a>
                </div>

                <div id="rejected-box" class="alert alert-warning mt-3" style="display:none;">
                    Owner rejected your call request.
                </div>

                <form method="POST" action="/calls/<%= call._id %>/cancel" class="mt-3">
                    <button class="btn btn-outline-danger">Cancel Request</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const callId = "<%= call._id %>";
    const listingId = "<%= call.listing._id %>";
    const statusEl = document.getElementById('call-status');
    const joinBox = document.getElementById('join-box');
    const rejectedBox = document.getElementById('rejected-box');
    const joinLink = document.getElementById('join-link');

    async function pollStatus() {
        try {
            const res = await fetch(`/calls/${callId}/status`);
            const data = await res.json();
            if (!res.ok) return;

            statusEl.textContent = data.status;
            if (data.status === 'accepted') {
                joinLink.href = `/video/${listingId}?callId=${callId}`;
                joinBox.style.display = 'block';
                return;
            }
            if (data.status === 'rejected' || data.status === 'cancelled') {
                rejectedBox.style.display = 'block';
                return;
            }
            setTimeout(pollStatus, 3000);
        } catch (e) {
            setTimeout(pollStatus, 4000);
        }
    }

    pollStatus();
</script>
